  "selection_policy": {
    "default_application": "E0_ONLY_UNLESS_REPLACED_BY_PROJECT_EVIDENCE",
    "rules": [
      "system defaults never promote project readiness above E0",
      "a selected regional method must match the project jurisdiction and applicability",
      "an OEM model is a nominal prior until the exact unit and configuration are measured",
      "unbound parameters become explicit local input templates instead of invented values",
      "custom values are always allowed when unit, schema and provenance are valid",
      "fail-closed values prevail while safety, permission or approval evidence is missing"
    ]

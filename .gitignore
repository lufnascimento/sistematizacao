# Python caches and local environments
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/
.venv/
venv/
env/

# Editors and operating-system metadata
.idea/
.vscode/
.DS_Store
Thumbs.db
Desktop.ini

# Local tools and transient files
.tools/
*.log
*.tmp
*.part
*.bak
~$*

# API state, uploads, run workspaces and detached-process logs
platform_runtime/
platform/data/
platform/terraflux_api/data/

# Browser-verification screenshots are regenerated by the test scripts
/preview*.png
/platform/web/preview*.png
/platform/web/verified*.png
/platform/web/mobile-overflow.png

# Client-specific legacy screens and one-off review generators remain local.
/legacy/demo-static/
/dataset/private_project/

# Client/source geospatial data and reproducible derived products stay local.
# Keep only the documentation that explains how to populate these folders.
/dataset/*
!/dataset/README.md
!/dataset/derived/
/dataset/derived/*
!/dataset/derived/README.md

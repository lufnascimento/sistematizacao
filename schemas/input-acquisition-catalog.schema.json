{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://terraflux.local/schemas/input-acquisition-catalog.schema.json",
  "title": "TerraFlux input acquisition catalog",
  "type": "object",
  "required": ["schema_version", "catalog_id", "evidence_packages"],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "catalog_id": {"const": "terraflux-input-acquisition-catalog"},
    "purpose": {"type": "string", "minLength": 1},
    "evidence_packages": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/evidencePackage"}
    }
  },
  "additionalProperties": false,
  "$defs": {
    "evidencePackage": {
      "type": "object",
      "required": [
        "id", "title", "domain", "purpose", "primary_parameter_ids",
        "supporting_parameter_ids", "required_for", "acquisition_modes",
        "data_contract", "field_protocol", "qa_requirements", "freshness",
        "owner_roles", "absence_policy", "blocker_codes"
      ],
      "properties": {
        "id": {"type": "string", "pattern": "^[A-Z][A-Z0-9_]+$"},
        "title": {"type": "string", "minLength": 1},
        "domain": {"enum": ["SCOPE", "TERRAIN", "SOIL", "HYDROLOGY", "CONSERVATION", "FLEET", "CONSTRAINTS", "CONNECTIONS", "POA", "LOGISTICS", "QUALITY", "LIFECYCLE", "QA"]},
        "purpose": {"type": "string", "minLength": 1},
        "primary_parameter_ids": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
        "supporting_parameter_ids": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
        "required_for": {
          "type": "object",
          "required": ["delivery_levels", "scenarios", "gates"],
          "properties": {
            "delivery_levels": {"type": "array", "items": {"enum": ["E0_TRIAGEM", "E1_OPERACIONAL", "E2_CONSERVACIONISTA", "E3_EXECUTIVO"]}, "uniqueItems": true},
            "scenarios": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
            "gates": {"type": "array", "items": {"type": "string"}, "uniqueItems": true}
          },
          "additionalProperties": false
        },
        "acquisition_modes": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["mode", "priority", "authority", "source_ref", "method", "can_prefill", "can_release", "limitations"],
            "properties": {
              "mode": {"enum": ["CLIENT_UPLOAD", "FIELD_SURVEY", "LAB_TEST", "TELEMETRY", "OFFICIAL_DATA", "OEM_DOCUMENT", "PROFESSIONAL_CALIBRATION", "SYSTEM_CALCULATION"]},
              "priority": {"type": "integer", "minimum": 1},
              "authority": {"type": "string", "minLength": 1},
              "source_ref": {"type": "string", "minLength": 1},
              "method": {"type": "string", "minLength": 1},
              "can_prefill": {"type": "boolean"},
              "can_release": {"type": "boolean"},
              "limitations": {"type": "string", "minLength": 1}
            },
            "additionalProperties": false
          }
        },
        "data_contract": {
          "type": "object",
          "required": ["accepted_formats", "geometry_types", "required_fields", "required_metadata"],
          "properties": {
            "accepted_formats": {"type": "array", "minItems": 1, "items": {"type": "string"}, "uniqueItems": true},
            "geometry_types": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
            "required_fields": {
              "type": "array",
              "items": {
                "type": "object",
                "required": ["name", "type", "unit", "required"],
                "properties": {
                  "name": {"type": "string", "minLength": 1},
                  "type": {"type": "string", "minLength": 1},
                  "unit": {"type": ["string", "null"]},
                  "required": {"type": "boolean"}
                },
                "additionalProperties": false
              }
            },
            "required_metadata": {"type": "array", "items": {"type": "string"}, "uniqueItems": true}
          },
          "additionalProperties": false
        },
        "field_protocol": {"type": "array", "items": {"type": "string", "minLength": 1}},
        "qa_requirements": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
        "freshness": {
          "type": "object",
          "required": ["policy", "max_age_days", "refresh_triggers"],
          "properties": {
            "policy": {"enum": ["PER_PROJECT", "PER_CROP_CYCLE", "PER_SEASON", "PER_MACHINE_CONFIGURATION", "PER_RULE_REVISION", "CONTINUOUS"]},
            "max_age_days": {"type": ["integer", "null"], "minimum": 1},
            "refresh_triggers": {"type": "array", "items": {"type": "string", "minLength": 1}}
          },
          "additionalProperties": false
        },
        "owner_roles": {"type": "array", "minItems": 1, "items": {"type": "string"}, "uniqueItems": true},
        "absence_policy": {"enum": ["SCREENING_ONLY", "NOT_EVALUATED", "BLOCK_E1", "BLOCK_E2", "BLOCK_E3"]},
        "blocker_codes": {"type": "array", "minItems": 1, "items": {"type": "string"}, "uniqueItems": true}
      },
      "additionalProperties": false
    }
  }
}

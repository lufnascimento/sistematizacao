{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://terraflux.local/schemas/preliminary-reach-routing-stage.schema.json",
  "title": "TerraFlux preliminary reach routing result",
  "type": "object",
  "required": [
    "schema_version", "manifest_type", "release", "project_id", "run_id",
    "request_ref", "source_hydrograph_release", "source_node_id", "method",
    "reach_count", "node_count", "outlet_node_ids", "input_volume_m3",
    "outlet_volume_m3", "mass_balance_status", "reaches", "outlets",
    "stage_status", "blocker_codes", "attenuation_evaluated",
    "backwater_evaluated", "hydraulic_capacity_evaluated",
    "failure_path_evaluated", "guidance_authorized", "limitations"
  ],
  "properties": {
    "schema_version": { "const": "1.0.0" },
    "manifest_type": { "const": "PRELIMINARY_REACH_ROUTING_RESULT" },
    "release": { "const": "PRELIMINARY_DAG_LAG_ROUTING_ONLY" },
    "project_id": { "type": "string", "minLength": 1 },
    "run_id": { "type": "string", "minLength": 1 },
    "request_ref": { "type": "object" },
    "source_hydrograph_release": { "const": "PCX2_TRIANGULAR_UNIT_HYDROGRAPH_SCREENING_ONLY" },
    "source_node_id": { "type": "string", "minLength": 1 },
    "method": { "const": "PURE_LAG_DENDRITIC_NETWORK_ROUTING" },
    "reach_count": { "type": "integer", "minimum": 1 },
    "node_count": { "type": "integer", "minimum": 2 },
    "outlet_node_ids": { "type": "array", "minItems": 1, "items": { "type": "string" }, "uniqueItems": true },
    "dry_reach_ids": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
    "input_volume_m3": { "type": "number", "minimum": 0 },
    "outlet_volume_m3": { "type": "number", "minimum": 0 },
    "mass_balance_residual_m3": { "type": "number" },
    "relative_mass_balance_residual": { "type": "number", "minimum": 0 },
    "mass_balance_status": { "const": "PASS" },
    "reaches": { "type": "array", "minItems": 1, "items": { "type": "object" } },
    "outlets": { "type": "object" },
    "stage_status": { "const": "PRELIMINARY_ROUTING_WITH_EXPLICIT_BLOCKERS" },
    "blocker_codes": { "type": "array", "minItems": 7, "items": { "type": "string" }, "uniqueItems": true },
    "attenuation_evaluated": { "const": false },
    "backwater_evaluated": { "const": false },
    "hydraulic_capacity_evaluated": { "const": false },
    "failure_path_evaluated": { "const": false },
    "guidance_authorized": { "const": false },
    "limitations": { "type": "array", "minItems": 8, "items": { "type": "string" }, "uniqueItems": true }
  },
  "additionalProperties": false
}

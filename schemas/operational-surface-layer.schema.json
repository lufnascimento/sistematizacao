{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://terraflux.local/schemas/operational-surface-layer.schema.json",
  "title": "Operational stop and maneuver surfaces",
  "type": "object",
  "required": ["schema_version", "surface_layers"],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "surface_layers": {
      "type": "array",
      "items": {"$ref": "#/$defs/surfaceLayer"}
    }
  },
  "additionalProperties": false,
  "$defs": {
    "surfaceLayer": {
      "type": "object",
      "required": [
        "surface_id",
        "surface_type",
        "dataset_ref",
        "geometry_type",
        "review_status",
        "termination_policy",
        "maneuver_policy",
        "operations"
      ],
      "properties": {
        "surface_id": {"type": "string", "minLength": 1},
        "surface_type": {
          "enum": [
            "HEADLAND",
            "CARRIER",
            "APPROVED_PORTAL",
            "TURN_AREA",
            "WORK_BOUNDARY",
            "POWER_BARRIER_EDGE",
            "TERRACE_EDGE",
            "UNCLASSIFIED_OBSTACLE_EDGE"
          ]
        },
        "dataset_ref": {"type": "string", "minLength": 1},
        "layer_name": {"type": ["string", "null"], "minLength": 1},
        "geometry_type": {"enum": ["LineString", "MultiLineString", "Polygon", "MultiPolygon"]},
        "review_status": {"enum": ["APPROVED", "REVIEWED", "UNCONFIRMED", "NOT_REVIEWED"]},
        "termination_policy": {"enum": ["SUPPORTED", "REQUIRED_BREAK", "PROHIBITED"]},
        "maneuver_policy": {"enum": ["AUTHORIZED", "REVIEW_REQUIRED", "PROHIBITED"]},
        "operations": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"enum": ["FURROW", "PLANT", "HARVEST", "TRANSSHIPMENT", "TRUCK"]}
        },
        "fleet_profile_ref": {"type": ["string", "null"]},
        "evidence_ref": {"type": ["string", "null"]}
      },
      "additionalProperties": false,
      "allOf": [
        {
          "if": {"properties": {"maneuver_policy": {"const": "AUTHORIZED"}}},
          "then": {
            "required": ["fleet_profile_ref", "evidence_ref"],
            "properties": {
              "review_status": {"const": "APPROVED"},
              "fleet_profile_ref": {"type": "string", "minLength": 1},
              "evidence_ref": {"type": "string", "minLength": 1}
            }
          }
        },
        {
          "if": {"properties": {"surface_type": {"const": "POWER_BARRIER_EDGE"}}},
          "then": {
            "properties": {
              "termination_policy": {"const": "REQUIRED_BREAK"},
              "maneuver_policy": {"const": "PROHIBITED"}
            }
          }
        },
        {
          "if": {"properties": {"surface_type": {"const": "UNCLASSIFIED_OBSTACLE_EDGE"}}},
          "then": {
            "properties": {
              "termination_policy": {"const": "REQUIRED_BREAK"},
              "maneuver_policy": {"const": "PROHIBITED"}
            }
          }
        }
      ]
    }
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://terraflux.local/schemas/preliminary-section-capacity-stage.schema.json",
  "title": "TerraFlux preliminary section capacity result",
  "type": "object",
  "required": ["schema_version", "manifest_type", "release", "project_id", "run_id", "request_ref", "source_routing_release", "method", "reach_count", "within_capacity_count", "exceeded_capacity_count", "stability_evaluated_count", "stability_exceeded_count", "condition_counts", "reaches", "stage_status", "blocker_codes", "backwater_evaluated", "unsteady_flow_evaluated", "admissible_velocity_or_shear_evaluated", "receiver_approved", "project_executive_authorized", "guidance_authorized", "limitations"],
  "properties": {
    "schema_version": { "const": "1.0.0" },
    "manifest_type": { "const": "PRELIMINARY_SECTION_CAPACITY_RESULT" },
    "release": { "const": "PRELIMINARY_TRAPEZOIDAL_MANNING_CAPACITY_ONLY" },
    "project_id": { "type": "string", "minLength": 1 },
    "run_id": { "type": "string", "minLength": 1 },
    "request_ref": { "type": "object" },
    "source_routing_release": { "const": "PRELIMINARY_DAG_LAG_ROUTING_ONLY" },
    "method": { "const": "MANNING_UNIFORM_FLOW_TRAPEZOIDAL_SECTION" },
    "reach_count": { "type": "integer", "minimum": 1 },
    "within_capacity_count": { "type": "integer", "minimum": 0 },
    "exceeded_capacity_count": { "type": "integer", "minimum": 0 },
    "stability_evaluated_count": { "type": "integer", "minimum": 0 },
    "stability_exceeded_count": { "type": "integer", "minimum": 0 },
    "condition_counts": {
      "type": "object",
      "required": ["NEW", "CURRENT", "DEGRADED"],
      "properties": {
        "NEW": { "type": "integer", "minimum": 0 },
        "CURRENT": { "type": "integer", "minimum": 0 },
        "DEGRADED": { "type": "integer", "minimum": 0 }
      },
      "additionalProperties": false
    },
    "reaches": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "condition_state", "preliminary_capacity_status", "preliminary_stability_status", "erosion_safety_approved"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "condition_state": { "enum": ["NEW", "CURRENT", "DEGRADED"] },
          "preliminary_capacity_status": { "enum": ["WITHIN_DECLARED_SECTION", "EXCEEDS_DECLARED_SECTION"] },
          "preliminary_stability_status": { "enum": ["NOT_EVALUATED", "WITHIN_DECLARED_LIMITS", "EXCEEDS_DECLARED_VELOCITY_LIMIT", "EXCEEDS_DECLARED_SHEAR_LIMIT", "EXCEEDS_BOTH_DECLARED_LIMITS"] },
          "erosion_safety_approved": { "const": false }
        }
      }
    },
    "stage_status": { "const": "PRELIMINARY_CAPACITY_WITH_EXPLICIT_BLOCKERS" },
    "blocker_codes": { "type": "array", "minItems": 6, "items": { "type": "string" }, "uniqueItems": true },
    "backwater_evaluated": { "const": false },
    "unsteady_flow_evaluated": { "const": false },
    "admissible_velocity_or_shear_evaluated": { "type": "boolean" },
    "receiver_approved": { "const": false },
    "project_executive_authorized": { "const": false },
    "guidance_authorized": { "const": false },
    "limitations": { "type": "array", "minItems": 9, "items": { "type": "string" }, "uniqueItems": true }
  },
  "additionalProperties": false
}
